{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/smartgrid-llm",
  "mcp": {
    "servers": {
      "smartgrid": {
        "type": "local",
        "command": [
          "/usr/bin/python3.14",
          "/home/achf/theses-Santus/smartgrid-mcp/server.py"
        ],
        "protocol": "auto",
        "codemode": false
      }
    }
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "smartgrid_list_running_pods",
      "resource": "*",
      "effect": "allow"
    }
  ]
}