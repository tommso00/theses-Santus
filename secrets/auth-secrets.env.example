# Credenziali dello stack Smart Grid.
# Copiare in auth-secrets.env (ignorato da Git), compilare, poi creare il Secret:
#
#   bash:        cp secrets/auth-secrets.env.example secrets/auth-secrets.env
#   PowerShell:  Copy-Item secrets\auth-secrets.env.example secrets\auth-secrets.env
#
#   kubectl create secret generic auth-secrets -n smartgrid --from-env-file=secrets/auth-secrets.env --dry-run=client -o yaml | kubectl apply -f -
#
# REGOLE DEL FORMATO (kubectl prende il valore alla lettera):
#   - una riga CHIAVE=valore, NIENTE virgolette
#   - niente spazi in fondo alla riga
#   - file in UTF-8 (in PowerShell non usare ">" o Out-File di Windows PowerShell 5,
#     che scrivono UTF-16: meglio Copy-Item o un editor)
#
# Generare valori casuali:
#   bash:        openssl rand -hex 24
#   PowerShell:  -join ((1..24) | % { '{0:x2}' -f (Get-Random -Max 256) })
#
# ATTENZIONE se il cluster ha già i PVC (installazioni precedenti):
#   - KEYCLOAK_DB_PASSWORD deve restare quella con cui il database è stato creato,
#     altrimenti Keycloak non si connette a PostgreSQL (CrashLoopBackOff).
#   - OAUTH2_PROXY_CLIENT_SECRET deve coincidere con quello salvato in Keycloak
#     (realm openems -> Clients -> openems-gateway -> Credentials).
#   - INFLUXDB_ADMIN_PASSWORD e INFLUXDB_TOKEN sono letti da InfluxDB solo al primo
#     avvio con PVC vuoto: dopo vanno cambiati in InfluxDB (vedi README).

# PostgreSQL di Keycloak (letta da PostgreSQL solo alla creazione del database)
KEYCLOAK_DB_PASSWORD=

# Admin di Keycloak (usata solo al primo avvio)
KEYCLOAK_ADMIN_PASSWORD=

# Password dell'utente di prova nel realm openems (usata solo all'import del realm)
KEYCLOAK_TESTUSER_PASSWORD=

# Client OIDC openems-gateway: secret condiviso tra Keycloak e OAuth2 Proxy
OAUTH2_PROXY_CLIENT_SECRET=

# Cookie secret di OAuth2 Proxy: DEVE essere di 16, 24 o 32 byte, altrimenti
# oauth2-proxy non parte. "openssl rand -hex 16" dà 32 caratteri: va bene.
#   PowerShell:  -join ((1..16) | % { '{0:x2}' -f (Get-Random -Max 256) })
OAUTH2_PROXY_COOKIE_SECRET=

# Utente della REST API degli Edge OpenEMS, usato dai bridge PMU (default dell'Edge)
OPENEMS_EDGE_USER=admin
OPENEMS_EDGE_PASSWORD=admin

# InfluxDB (storico del Backend). Il token è usato dal Backend per leggere e scrivere.
# Solo caratteri esadecimali (openssl rand -hex 32), per evitare problemi di escape.
INFLUXDB_ADMIN_PASSWORD=
INFLUXDB_TOKEN=
